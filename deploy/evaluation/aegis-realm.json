{
  "realm": "aegis-evaluation",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "groups": [
    {
      "name": "aegis-admins"
    }
  ],
  "clients": [
    {
      "clientId": "aegis-proxy",
      "name": "AegisProxy evaluation",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "aegis-evaluation-client-secret",
      "redirectUris": [
        "http://localhost:9090/v1/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:9090"
      ],
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@localhost.invalid",
      "firstName": "Local",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "aegis-evaluation-only",
          "temporary": false
        }
      ],
      "groups": [
        "/aegis-admins"
      ]
    }
  ]
}
