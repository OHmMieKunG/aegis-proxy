{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisproxy.invalid/schema/config-v1.json",
  "title": "AegisProxy configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "runtime": { "$ref": "#/$defs/runtime" },
    "limits": { "$ref": "#/$defs/limits" },
    "listeners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/listener" }
    },
    "tls": { "$ref": "#/$defs/tls" },
    "certificates": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/certificate" }
    },
    "trusted_proxies": { "$ref": "#/$defs/trustedProxies" },
    "upstream_groups": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/upstreamGroup" }
    },
    "providers": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/provider" }
    },
    "middlewares": {
      "type": "object",
      "maxProperties": 1024,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/middleware" }
    },
    "routes": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/route" }
    },
    "admin": { "$ref": "#/$defs/admin" },
    "observability": { "$ref": "#/$defs/observability" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "secretRef": {
      "type": "string",
      "minLength": 7,
      "maxLength": 4096,
      "pattern": "^(env://|file://).+"
    },
    "cidr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state_dir": { "type": "string", "minLength": 1, "maxLength": 4096, "default": "./state" },
        "shutdown_grace_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30 },
        "config_poll_secs": { "type": "integer", "minimum": 1, "maximum": 300, "default": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_connections": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 4096 },
        "max_header_bytes": { "type": "integer", "minimum": 8192, "maximum": 1048576, "default": 32768 },
        "max_headers": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 100 },
        "max_request_target": { "type": "integer", "minimum": 1024, "maximum": 65536, "default": 8192 },
        "max_http2_streams": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 128 },
        "max_health_checks": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 64 },
        "max_dns_lookups": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 32 },
        "tcp_connect_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 300, "default": 5 },
        "tcp_idle_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 300 },
        "tcp_connection_lifetime_secs": { "type": "integer", "minimum": 1, "maximum": 604800, "default": 86400 },
        "max_request_body": { "type": "integer", "minimum": 1, "maximum": 1073741824, "default": 33554432 },
        "request_header_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 300, "default": 10 },
        "response_header_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30 }
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bind", "protocol"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "bind": { "type": "string", "minLength": 3, "maxLength": 128 },
        "protocol": { "enum": ["http", "https", "tcp", "tls_passthrough"] },
        "certificates": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_version": { "enum": ["1.2", "1.3"], "default": "1.2" },
        "max_handshakes": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 256 },
        "handshake_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 300, "default": 10 },
        "identity": { "$ref": "#/$defs/secretRef" }
      }
    },
    "dnsName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 253,
      "pattern": "^(\\*\\.)?[a-z0-9](?:[a-z0-9.-]*[a-z0-9])$"
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hosts", "certificate_chain", "private_key"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dnsName" }
        },
        "certificate_chain": { "$ref": "#/$defs/secretRef" },
        "private_key": { "$ref": "#/$defs/secretRef" }
      }
    },
    "trustedProxies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cidrs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/cidr" } },
        "trusted_hops": { "type": "integer", "minimum": 0, "maximum": 32, "default": 0 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^(https?|tcp)://" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1 },
        "server_name": { "$ref": "#/$defs/dnsName" },
        "ca_bundle": { "$ref": "#/$defs/secretRef" }
      }
    },
    "dnsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_answers": { "type": "integer", "minimum": 1, "maximum": 64, "default": 16 },
        "lookup_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 30, "default": 3 },
        "min_ttl_secs": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 5 },
        "max_ttl_secs": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 300 },
        "stale_timeout_secs": { "type": "integer", "minimum": 0, "maximum": 3600, "default": 300 }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["http", "tcp"], "default": "http" },
        "method": { "enum": ["GET", "HEAD"], "default": "GET" },
        "path": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/", "default": "/" },
        "expected_statuses": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "default": [200] },
        "interval_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 10 },
        "timeout_secs": { "type": "integer", "minimum": 1, "maximum": 3599, "default": 2 },
        "unhealthy_threshold": { "type": "integer", "minimum": 1, "maximum": 100, "default": 3 },
        "healthy_threshold": { "type": "integer", "minimum": 1, "maximum": 100, "default": 2 }
      }
    },
    "passiveHealth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_threshold": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 },
        "healthy_threshold": { "type": "integer", "minimum": 1, "maximum": 100, "default": 2 },
        "window_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30 },
        "max_samples": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 64 }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 },
        "total_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 },
        "replay_body_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576, "default": 0 }
      }
    },
    "circuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_size": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 100 },
        "minimum_requests": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 20 },
        "failure_percent": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
        "open_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 10 },
        "half_open_requests": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 }
      }
    },
    "upstreamGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "endpoints"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "algorithm": { "enum": ["round_robin", "smooth_weighted_round_robin", "random", "power_of_two"], "default": "round_robin" },
        "allowed_cidrs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/cidr" } },
        "denied_cidrs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/cidr" } },
        "dns": { "$ref": "#/$defs/dnsPolicy" },
        "health": { "$ref": "#/$defs/healthCheck" },
        "passive_health": { "$ref": "#/$defs/passiveHealth" },
        "retry": { "$ref": "#/$defs/retryPolicy" },
        "circuit_breaker": { "$ref": "#/$defs/circuitBreaker" },
        "max_in_flight": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 1024 },
        "drain_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30 },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/endpoint" }
        }
      }
    },
    "provider": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "upstream_group", "path", "scheme"],
          "properties": {
            "kind": { "const": "file" },
            "id": { "$ref": "#/$defs/id" },
            "enabled": { "type": "boolean", "default": false },
            "upstream_group": { "$ref": "#/$defs/id" },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" },
            "scheme": { "enum": ["http", "https", "tcp"] },
            "server_name": { "$ref": "#/$defs/dnsName" },
            "ca_bundle": { "$ref": "#/$defs/secretRef" },
            "refresh_secs": { "type": "integer", "minimum": 1, "maximum": 300, "default": 5 },
            "debounce_millis": { "type": "integer", "minimum": 50, "maximum": 5000, "default": 250 },
            "stale_after_secs": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 300 },
            "max_endpoints": { "type": "integer", "minimum": 1, "maximum": 256, "default": 64 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "upstream_group", "hostname", "port", "scheme"],
          "properties": {
            "kind": { "const": "dns" },
            "id": { "$ref": "#/$defs/id" },
            "enabled": { "type": "boolean", "default": false },
            "upstream_group": { "$ref": "#/$defs/id" },
            "hostname": { "$ref": "#/$defs/dnsName" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "scheme": { "enum": ["http", "https", "tcp"] },
            "server_name": { "$ref": "#/$defs/dnsName" },
            "ca_bundle": { "$ref": "#/$defs/secretRef" },
            "weight": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1 },
            "refresh_secs": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 },
            "stale_after_secs": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 300 },
            "max_answers": { "type": "integer", "minimum": 1, "maximum": 64, "default": 16 }
          }
        }
      ]
    },
    "headerMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" },
        "value": { "type": "string", "maxLength": 1024 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "listeners"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "listeners": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "hosts": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/dnsName" } },
        "paths": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/" } },
        "path_prefixes": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/" } },
        "methods": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9!#$%&'*+.^_`|~-]+$" } },
        "headers": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/headerMatch" } },
        "default": { "type": "boolean", "default": false },
        "priority": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647, "default": 0 },
        "middlewares": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "upstream_group": { "$ref": "#/$defs/id" }
      }
    },
    "middleware": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "security_headers" },
            "hsts": { "type": ["string", "null"], "maxLength": 1024 },
            "content_security_policy": { "type": ["string", "null"], "maxLength": 8192 },
            "override_existing": { "type": "boolean", "default": false },
            "acknowledge_hsts_risk": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requests_per_second", "burst"],
          "properties": {
            "type": { "const": "rate_limit" },
            "key": { "enum": ["client_ip", "principal"], "default": "client_ip" },
            "requests_per_second": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "burst": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "max_keys": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 10000 },
            "idle_secs": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 300 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "max_requests", "max_per_client"],
          "properties": {
            "type": { "const": "in_flight_limit" },
            "max_requests": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "max_per_client": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "status": { "enum": [429, 503], "default": 503 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "ip_policy" },
            "allow": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/cidr" } },
            "deny": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/cidr" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "origins", "methods"],
          "properties": {
            "type": { "const": "cors" },
            "origins": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "maxLength": 2048 } },
            "methods": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } },
            "headers": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
            "allow_credentials": { "type": "boolean", "default": false },
            "max_age_secs": { "type": "integer", "minimum": 0, "maximum": 86400, "default": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "realm", "users"],
          "properties": {
            "type": { "const": "basic_auth" },
            "realm": { "type": "string", "minLength": 1, "maxLength": 64 },
            "users": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 64,
              "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64 },
              "additionalProperties": { "type": "string", "pattern": "^(env://[A-Za-z_][A-Za-z0-9_]*|file:///.*)$" }
            },
            "max_concurrent_verifications": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 8 },
            "timeout_secs": { "type": "integer", "minimum": 1, "maximum": 30, "default": 5 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "upstream_group", "path", "response_headers", "principal_header"],
          "properties": {
            "type": { "const": "forward_auth" },
            "upstream_group": { "$ref": "#/$defs/id" },
            "path": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/" },
            "request_headers": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } },
            "response_headers": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } },
            "principal_header": { "type": "string", "minLength": 1, "maxLength": 64 },
            "redirect_hosts": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/dnsName" } },
            "timeout_secs": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "to"],
          "properties": {
            "type": { "const": "rewrite" },
            "from_prefix": { "type": ["string", "null"], "minLength": 1, "maxLength": 2048, "pattern": "^/" },
            "to": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "header_mutation" },
            "request_set": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "maxLength": 8192 } },
            "request_add": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 8192 } } },
            "request_remove": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
            "response_set": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "maxLength": 8192 } },
            "response_add": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 8192 } } },
            "response_remove": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "body"],
          "properties": {
            "type": { "const": "maintenance" },
            "status": { "enum": [200, 503], "default": 503 },
            "body": { "type": "string", "minLength": 1, "maxLength": 65536 },
            "content_type": { "enum": ["text/plain; charset=utf-8", "text/html; charset=utf-8"], "default": "text/plain; charset=utf-8" },
            "retry_after_secs": { "type": ["integer", "null"], "minimum": 1, "maximum": 86400 },
            "authenticated": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "statuses", "body"],
          "properties": {
            "type": { "const": "custom_error" },
            "statuses": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 500, "maximum": 599 } },
            "body": { "type": "string", "minLength": 1, "maxLength": 65536 },
            "content_type": { "enum": ["text/plain; charset=utf-8", "text/html; charset=utf-8"], "default": "text/plain; charset=utf-8" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "encodings", "content_types"],
          "properties": {
            "type": { "const": "compression" },
            "encodings": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["gzip", "brotli"] } },
            "content_types": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 127 } },
            "min_bytes": { "type": "integer", "minimum": 256, "maximum": 1048576, "default": 1024 },
            "max_concurrent": { "type": "integer", "minimum": 1, "maximum": 32, "default": 4 },
            "allow_authenticated": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "location", "status"],
          "properties": {
            "type": { "const": "redirect" },
            "location": { "type": "string", "maxLength": 2048 },
            "status": { "enum": [301, 302, 303, 307, 308] },
            "preserve_query": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unix_socket": { "type": ["string", "null"], "maxLength": 4096 },
        "allowed_uids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "audit_key": { "type": ["string", "null"], "maxLength": 4096 },
        "max_body_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "default": 1048576 },
        "max_in_flight": { "type": "integer", "minimum": 1, "maximum": 256, "default": 16 },
        "max_auth_in_flight": { "type": "integer", "minimum": 1, "maximum": 32, "default": 4 },
        "request_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 60, "default": 10 },
        "requests_per_second": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 20 },
        "burst": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 40 }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access_log": { "type": "boolean", "default": true },
        "access_log_sample_per_million": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 1000000 },
        "metrics": { "type": "boolean", "default": true },
        "otlp_traces": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["endpoint", "sample_per_million", "max_queue_size", "max_export_batch_size", "export_timeout_secs"],
          "properties": {
            "endpoint": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https?://" },
            "sample_per_million": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "max_queue_size": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "max_export_batch_size": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "export_timeout_secs": { "type": "integer", "minimum": 1, "maximum": 30 }
          }
        }
      }
    }
  }
}
